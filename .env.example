# TaskFlow Environment Variables Configuration
# Copy this file to .env and replace the values with your actual EC2 IP and secure credentials

# --- FRONTEND (Vite) ---
# This is baked into the React app during the build step. 
# Point this to your EC2 public IP or domain name.
VITE_API_BASE_URL=http://YOUR_EC2_PUBLIC_IP:8080

# --- BACKEND (Spring Boot) ---
# Database configuration. If running Postgres locally on EC2, these are usually fine.
DB_URL=jdbc:postgresql://localhost:5432/taskflow
DB_USERNAME=postgres
DB_PASSWORD=Admin

# Allowed origins for CORS. Point this to the domain or IP where your frontend is hosted.
CORS_ALLOWED_ORIGINS=http://YOUR_EC2_PUBLIC_IP

# JWT Secret Key (Should be at least 256 bits / 32 characters long)
JWT_SECRET=supersecretkeysupersecretkeysupersecretkeysupersecretkey
JWT_EXPIRATION_MS=86400000
