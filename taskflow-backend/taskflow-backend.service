[Unit]
Description=TaskFlow Spring Boot Backend
After=network.target postgresql.service

[Service]
User=ubuntu
# Update this path if you clone the project somewhere else
WorkingDirectory=/home/ubuntu/TaskFlow/taskflow-backend

# Load environment variables from the root .env file
EnvironmentFile=/home/ubuntu/TaskFlow/.env

# The jar file name based on your pom.xml (artifactId: backend, version: 0.0.1-SNAPSHOT)
ExecStart=/usr/bin/java -jar target/backend-0.0.1-SNAPSHOT.jar
SuccessExitStatus=143
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
